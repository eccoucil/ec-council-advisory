DATABASE_URL="postgresql://postgres:postgres@localhost:5436/ec_council_advisory"
AUTH_SECRET=""
RESEND_API_KEY=""
RESEND_FROM_EMAIL="EC-Council Advisory Board <noreply@ecc0uncil.org>"

# Seeds the administrator account via `pnpm db:seed` (never commit real values)
ADMIN_EMAIL="admin@eccouncil.org"
ADMIN_PASSWORD=""

# Base URL used in reminder emails
APP_URL="http://localhost:3000"

# Local only: print emails (including access codes) to the server log when
# RESEND_API_KEY is absent. Never enable outside a developer machine.
MAIL_CONSOLE_FALLBACK="false"
